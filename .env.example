# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=studio
POSTGRES_PASSWORD=studio
POSTGRES_DB=studio_rags
# Host port for the container. Change this if you already run Postgres
# locally on 5432 — the container port stays 5432 either way.
POSTGRES_PORT=5432
# Two URLs for the same database. Locally (and in CI) they are identical.
#
# DATABASE_URL — what the running API uses. On Neon, the POOLED host: the one
#   whose endpoint id ends in "-pooler", which routes through PgBouncer.
# DATABASE_URL_UNPOOLED — what Prisma Migrate uses (schema.prisma directUrl).
#   On Neon, the DIRECT host, without "-pooler". Migrations need a real
#   session, which PgBouncer's transaction mode does not give them.
#
# On Neon, both need sslmode=require, and connect_timeout=15 so that waking a
# compute from scale-to-zero does not trip Prisma's 5-second default (P1001):
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-NAME-pooler.ap-southeast-1.aws.neon.tech/DBNAME?sslmode=require&connect_timeout=15
#   DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-NAME.ap-southeast-1.aws.neon.tech/DBNAME?sslmode=require&connect_timeout=15
DATABASE_URL=postgresql://studio:studio@localhost:5432/studio_rags
DATABASE_URL_UNPOOLED=postgresql://studio:studio@localhost:5432/studio_rags

# ── Backend (NestJS) ────────────────────────────────────────────────────────
# Render sets PORT itself (10000); 3001 is the local default.
PORT=3001
# Interface to bind. 0.0.0.0 (the default) is what Render and Docker need;
# 127.0.0.1 keeps a local server off the network.
HOST=0.0.0.0
# Number of reverse-proxy hops in front of the API whose X-Forwarded-For can be
# trusted. 0 (the default) trusts none: right for local dev, where a client
# could forge the header. Set it to the real hop count when deployed behind a
# load balancer, so rate limiting sees each visitor's own IP. Count only
# proxies that append to X-Forwarded-For: the frontend Docker image does (one
# hop), a bare `next start` does not (docs/deploy/README.md, Check TRUST_PROXY).
TRUST_PROXY=0
# Shared by the API and the frontend's proxy (frontend/src/proxy.ts), which
# sends it with each visitor's address so the API can tell visitors apart
# behind Vercel. Staging only: set the same value on Vercel and Render
# (docs/deploy/README.md, Check TRUST_PROXY). Leave unset locally.
# Generate with: openssl rand -hex 32
# API_PROXY_SECRET=
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
# Public base URL of the web client — used to build links inside emails.
APP_URL=http://localhost:3000

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate each with: openssl rand -base64 48. Two separate values: the API
# refuses to start if they are the same.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Seed (npm run db:seed) ──────────────────────────────────────────────────
# The admin account the seed creates. Without a password the seed uses a
# public development one, and only for a database on localhost. Anywhere else
# set SEED_ADMIN_PASSWORD (at least 12 characters).
SEED_ADMIN_EMAIL=admin@studiorags.com.au
SEED_ADMIN_PASSWORD=
# An existing admin keeps its password on later runs. Set to 1 to replace it.
SEED_ADMIN_ROTATE=

# ── Payments: Stripe ────────────────────────────────────────────────────────
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Money is stored and charged in the smallest currency unit (cents).
CURRENCY=aud

# ── Email ───────────────────────────────────────────────────────────────────
# MAIL_TRANSPORT is smtp, resend, or memory (tests only: nothing is sent).
# Every send is recorded in the email_logs table, whichever is used. The rules
# are in backend/src/mail/mail.config.ts; a bad value stops the API at boot.
#
# Development: Mailpit via docker compose — no auth, nothing leaves the
# machine. Read what was sent at http://localhost:8025.
MAIL_TRANSPORT=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Studio Rags <hello@studiorags.com.au>"
# Who may receive real mail: addresses separated by commas, or * for anyone.
# Anyone else gets an email_logs row marked SUPPRESSED and no email (ADR-040).
# Leave blank locally: Mailpit catches everything anyway.
MAIL_ALLOWED_RECIPIENTS=
# Staging: MAIL_TRANSPORT=resend, with this key, MAIL_FROM set to
# "Studio Rags <onboarding@resend.dev>" and MAIL_ALLOWED_RECIPIENTS set to the
# Resend account owner's address. On resend the API refuses to start without
# all three (docs/deploy/README.md, "Email through Resend").
RESEND_API_KEY=

# ── Media storage ───────────────────────────────────────────────────────────
# Workshop photography and brand assets. See docs/SPEC.md § Media & assets.
#
# Optional. Leave all of it blank and the API runs without storage (local dev,
# CI); GET /api/v1/health then reports storage "not-configured". The first
# three are all-or-nothing: setting only some of them stops the API at boot.
#
# These are the standard AWS SDK names, so the same code talks to Neon Object
# Storage today and to real AWS S3 later:
#   - Neon: `neon env pull` (or neon link/checkout/deploy) writes all of them.
#     Neon needs path-style requests, which the API switches on whenever
#     AWS_ENDPOINT_URL_S3 is set.
#   - Real AWS S3: omit AWS_ENDPOINT_URL_S3 entirely; the SDK then uses the
#     regional AWS endpoint.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_ENDPOINT_URL_S3=
# Private bucket; browsers get time-limited presigned links. Defaults to
# "assets", the bucket declared in neon.ts.
STORAGE_BUCKET=assets

# ── Frontend (Next.js) ──────────────────────────────────────────────────────
# Superseded by the same-origin proxy below: the browser now calls /api/v1 on
# the web origin and never needs the API's address. Kept until nothing reads it.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side only (never sent to the browser). Next.js rewrites /api/v1/* to
# API_ORIGIN/api/v1/*, so auth cookies stay first-party on the web origin.
API_ORIGIN=http://localhost:3001
# Which deployment this is: staging (the demo) or production.
SITE_ENV=staging
# Marketing pixels — left blank until the client supplies IDs (FR-M1).
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
