# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=studio
POSTGRES_PASSWORD=studio
POSTGRES_DB=studio_rags
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://studio:studio@localhost:5432/studio_rags

# ── Backend (NestJS) ────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── LLM: Anthropic (generation) ─────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ── Embeddings: Voyage AI ───────────────────────────────────────────────────
# Anthropic has no embeddings endpoint; Voyage is their recommended pairing.
# https://dashboard.voyageai.com/
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
# Must match the embedding dimension of VOYAGE_MODEL (voyage-3 = 1024)
EMBEDDING_DIMENSION=1024

# ── Retrieval tuning ────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5

# ── Frontend (Next.js) ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
