# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=studio
POSTGRES_PASSWORD=studio
POSTGRES_DB=studio_rags
# Host port for the container. Change this if you already run Postgres
# locally on 5432 — the container port stays 5432 either way.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://studio:studio@localhost:5432/studio_rags

# ── Backend (NestJS) ────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
# Public base URL of the web client — used to build links inside emails.
APP_URL=http://localhost:3000

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Payments: Stripe ────────────────────────────────────────────────────────
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Money is stored and charged in the smallest currency unit (cents).
CURRENCY=aud

# ── Email ───────────────────────────────────────────────────────────────────
# Development: Mailpit via docker compose — no auth, nothing leaves the machine.
MAIL_TRANSPORT=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Studio Rags <hello@studiorags.com.au>"
# Production: set MAIL_TRANSPORT=resend and supply the key instead.
RESEND_API_KEY=

# ── Media storage ───────────────────────────────────────────────────────────
# Workshop photography and brand assets. See docs/SPEC.md § Media & assets.
S3_ENDPOINT=
S3_REGION=ap-southeast-2
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Frontend (Next.js) ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Marketing pixels — left blank until the client supplies IDs (FR-M1).
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
