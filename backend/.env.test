# Test-only environment for the e2e suite and CI. Committed on purpose:
# nothing here is a secret, and every value is useless outside a test run.
#
# Loaded with `dotenv -o -e .env.test -- ...` BEFORE Nest starts. The -o flag
# makes these values win over anything already exported in the shell, so a
# stray DATABASE_URL from another project cannot redirect the suite.
# With NODE_ENV=test the app's ConfigModule ignores env files altogether, so
# nothing is back-filled from the developer's real ../.env (Stripe, mail and
# other secrets). This file is therefore the whole test environment: a
# variable missing here is simply unset, so keep it complete.

NODE_ENV=test

# Host port 5433 matches the local Docker container and the CI service
# container. The database name must end in "_test": the e2e harness and
# scripts/assert-test-database.js both refuse to touch anything else.
DATABASE_URL=postgresql://studio:studio@localhost:5433/studio_rags_test
# Prisma Migrate's direct connection (schema.prisma directUrl). Only Neon
# separates pooled and direct hosts; everywhere else they are the same URL.
DATABASE_URL_UNPOOLED=postgresql://studio:studio@localhost:5433/studio_rags_test

# TEST-ONLY signing keys. Never reuse these anywhere real.
JWT_ACCESS_SECRET=test-only-access-secret-not-for-any-real-environment-0001
JWT_REFRESH_SECRET=test-only-refresh-secret-not-for-any-real-environment-0002
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# Object storage stays switched off in tests: readiness reports
# "not-configured" and nothing can reach a real bucket. Set empty rather than
# left out, so that with -o they also blank any AWS_* a developer's shell
# exports (a lone AWS_REGION would otherwise count as a half-configured
# storage block and stop the app at boot).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_ENDPOINT_URL_S3=

# Mail goes to an in-memory outbox: nothing is delivered anywhere, and the
# tests read messages back from it (test/mail). The rest are blank so a value
# exported in the shell, a real RESEND_API_KEY say, cannot reach the suite.
MAIL_TRANSPORT=memory
MAIL_FROM=
MAIL_ALLOWED_RECIPIENTS=
RESEND_API_KEY=
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=

# Off, so the API believes no forwarded visitor address, and blank rather than
# left out so a value exported in the shell cannot switch it on.
# test/auth/proxy-secret.e2e-spec.ts sets its own for the one file that needs it.
API_PROXY_SECRET=
