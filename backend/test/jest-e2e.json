{
  "moduleFileExtensions": ["js", "json", "ts", "tsx"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)sx?$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!@nestjs/(config|jwt|passport)/)"
  ],
  "setupFiles": ["<rootDir>/utils/assert-test-env.ts"],
  "restoreMocks": true,
  "testTimeout": 30000
}
